generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  TECH
  DESIGN
  PRODUCT
  UX
}

enum PostSource {
  AUTO
  MANUAL
}

// SOLO_WEB: no va a LinkedIn (valor por defecto).
// PENDIENTE: marcado para LinkedIn, esperando aprobación en el panel.
// APROBADO: aprobado; el cron lo publica en cuanto el post está en la web.
// PUBLICADO: ya salió en LinkedIn. No se vuelve a tocar.
enum LinkedInEstado {
  SOLO_WEB
  PENDIENTE
  APROBADO
  PUBLICADO
}

model Post {
  id             Int        @id @default(autoincrement())
  image          String
  category       Category
  date           DateTime
  published      Boolean    @default(false)
  published_sent Boolean    @default(false)
  source         PostSource @default(MANUAL)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Publicación en la página de empresa de LinkedIn. Por defecto, solo web.
  // Nada sale a LinkedIn sin pasar por APROBADO desde el panel (ver
  // app/lib/linkedin/aprobacion.js).
  linkedinEstado      LinkedInEstado @default(SOLO_WEB)
  linkedinAprobadoAt  DateTime?
  linkedinPublicadoAt DateTime?

  translations     PostTranslation[]
  linkedinVariants LinkedInVariant[]
  linkedinEnvios   LinkedInEnvio[]
}

// Publicaciones automáticas en LinkedIn (página de empresa y perfil de José),
// una fila por canal y día. Guarda el texto enviado para no repetir ideas ni
// frases iniciales, el estado para el reintento de los 15 minutos y sirve de
// registro para el informe. Ver app/lib/linkedin/autopost.js.
enum LinkedInCanal {
  EMPRESA
  PERSONAL
}

enum LinkedInEnvioEstado {
  ENVIADO
  FALLIDO
}

model LinkedInEnvio {
  id        Int                 @id @default(autoincrement())
  canal     LinkedInCanal
  dia       DateTime            @db.Date // día de Madrid del envío
  postId    Int?
  texto     String?             @db.Text
  idea      String?             @db.Text // la idea en una frase, para la deduplicación
  payload   Json? // lo que se manda a Make; el reintento reenvía esto mismo
  estado    LinkedInEnvioEstado
  intentos  Int                 @default(1)
  error     String?             @db.Text
  enviadoAt DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  post Post? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@unique([canal, dia])
  @@index([canal, estado, enviadoAt])
}

model PostRedirect {
  id        Int      @id @default(autoincrement())
  fromSlug  String
  toSlug    String? // null = sin destino (404/410)
  lang      String // "es" | "en"
  reason    String? // motivo opcional para debug (fused-into, pruned, etc.)
  createdAt DateTime @default(now())

  @@unique([fromSlug, lang])
  @@index([lang])
}

model LinkedInVariant {
  id              Int       @id @default(autoincrement())
  postId          Int
  variant         Int // 1, 2, 3
  angle           String // "data" | "polemica" | "conclusion"
  text            String    @db.Text
  hashtags        String[]  @default([])
  imageBlobUrl    String
  imageQuery      String?
  crossNote       String?   @db.Text // sugerencia de comentario o recompartición
  linkedinPostUrl String? // URL del post publicado, la devuelve Make
  scheduledFor    DateTime
  sent            Boolean   @default(false)
  sentAt          DateTime?
  createdAt       DateTime  @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, variant])
  @@index([scheduledFor, sent])
}

model PostTranslation {
  id      Int      @id @default(autoincrement())
  postId  Int
  lang    String
  slug    String   @unique
  title   String
  tags    String[]
  content String   @db.Text

  linkedinPost     String?  @db.Text
  linkedinHashtags String[] @default([])
  metaDescription  String?
  // Título corto para <title> y og:title (≤ 49: el layout añade " | Room 714").
  // Null = se usa `title`. El H1 del post siempre es `title`.
  metaTitle        String?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, lang])
}

enum CandidatePosition {
  DEVELOPER
  DESIGNER
  PRODUCT_MANAGER
  AI_DATA_SPECIALIST
}

enum CandidateEducation {
  GRADO
  MASTER
  DOCTORADO
  OTHER
}

model Candidate {
  id        Int                @id @default(autoincrement())
  createdAt DateTime           @default(now())
  position  CandidatePosition
  country   String
  education CandidateEducation
  cvBlobUrl String
  aiSummary String?            @db.Text
  emailSent Boolean            @default(false)
  expiresAt DateTime

  @@index([expiresAt])
}

// Contactos que llegan desde la web: el formulario de Hablemos, el de la
// landing de formación en IA y el inventario de IA. Antes no se guardaban en
// ningún sitio: solo llegaba un email. `origen` dice de dónde vino.
model Lead {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  origen      String
  email       String
  nombre      String?
  empresa     String?
  mensaje     String?  @db.Text
  situacion   String?
  empleados   String?
  // Respuestas del inventario de IA y su resultado, tal como se vieron.
  respuestas  Json?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  gclid       String?

  @@index([createdAt])
  @@index([origen])
}
