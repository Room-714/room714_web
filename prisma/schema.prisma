generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  TECH
  DESIGN
  PRODUCT
  UX
}

enum PostSource {
  AUTO
  MANUAL
}

model Post {
  id             Int               @id @default(autoincrement())
  image          String
  category       Category
  date           DateTime
  published      Boolean           @default(false)
  published_sent Boolean           @default(false)
  source         PostSource        @default(MANUAL)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  translations     PostTranslation[]
  linkedinVariants LinkedInVariant[]
}

model LinkedInVariant {
  id           Int       @id @default(autoincrement())
  postId       Int
  variant      Int       // 1, 2, 3
  angle        String    // "data" | "polemica" | "conclusion"
  text         String    @db.Text
  hashtags     String[]  @default([])
  imageBlobUrl String
  imageQuery   String?
  scheduledFor DateTime
  sent         Boolean   @default(false)
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  post         Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, variant])
  @@index([scheduledFor, sent])
}

model PostTranslation {
  id      Int      @id @default(autoincrement())
  postId  Int
  lang    String
  slug    String   @unique
  title   String
  tags    String[]
  content String   @db.Text

  linkedinPost     String?  @db.Text
  linkedinHashtags String[] @default([])
  metaDescription  String?

  post    Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, lang])
}

enum CandidatePosition {
  DEVELOPER
  DESIGNER
  PRODUCT_MANAGER
}

enum CandidateEducation {
  GRADO
  MASTER
  DOCTORADO
  OTHER
}

model Candidate {
  id          Int                 @id @default(autoincrement())
  createdAt   DateTime            @default(now())
  position    CandidatePosition
  country     String
  education   CandidateEducation
  cvBlobUrl   String
  aiSummary   String?             @db.Text
  emailSent   Boolean             @default(false)
  expiresAt   DateTime

  @@index([expiresAt])
}