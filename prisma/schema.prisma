generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  TECH
  DESIGN
  PRODUCT
  UX
}

enum PostSource {
  AUTO
  MANUAL
}

model Post {
  id             Int        @id @default(autoincrement())
  image          String
  category       Category
  date           DateTime
  published      Boolean    @default(false)
  published_sent Boolean    @default(false)
  source         PostSource @default(MANUAL)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  translations     PostTranslation[]
  linkedinVariants LinkedInVariant[]
}

model PostRedirect {
  id        Int      @id @default(autoincrement())
  fromSlug  String
  toSlug    String? // null = sin destino (404/410)
  lang      String // "es" | "en"
  reason    String? // motivo opcional para debug (fused-into, pruned, etc.)
  createdAt DateTime @default(now())

  @@unique([fromSlug, lang])
  @@index([lang])
}

model LinkedInVariant {
  id              Int       @id @default(autoincrement())
  postId          Int
  variant         Int // 1, 2, 3
  angle           String // "data" | "polemica" | "conclusion"
  text            String    @db.Text
  hashtags        String[]  @default([])
  imageBlobUrl    String
  imageQuery      String?
  crossNote       String?   @db.Text // sugerencia de comentario o recompartición
  linkedinPostUrl String? // URL del post publicado, la devuelve Make
  scheduledFor    DateTime
  sent            Boolean   @default(false)
  sentAt          DateTime?
  createdAt       DateTime  @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, variant])
  @@index([scheduledFor, sent])
}

model PostTranslation {
  id      Int      @id @default(autoincrement())
  postId  Int
  lang    String
  slug    String   @unique
  title   String
  tags    String[]
  content String   @db.Text

  linkedinPost     String?  @db.Text
  linkedinHashtags String[] @default([])
  metaDescription  String?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, lang])
}

// ─── Prospección en LinkedIn ────────────────────────────────────────────────
// Clientes potenciales cuya actividad se comenta manualmente desde el perfil
// de José. El briefing diario rota sobre los ACTIVE menos atendidos y el admin
// (/admin/prospects) redacta el comentario con IA. Nada se publica solo:
// LinkedIn no permite automatizar comentarios en publicaciones de terceros.
enum ProspectStatus {
  ACTIVE // en rotación diaria
  PAUSED // fuera de rotación temporalmente
  CLIENT // convertido: fuera de rotación
  DISCARDED // descartado: fuera de rotación
}

model Prospect {
  id            Int            @id @default(autoincrement())
  name          String // persona o empresa
  company       String?
  role          String? // cargo, si es persona
  linkedinUrl   String         @unique // URL del perfil o de la página
  sector        String?
  interest      String? // servicio de Room714 que encaja (texto libre)
  keywords      String[]       @default([]) // temas por los que comentarle
  notes         String?        @db.Text
  status        ProspectStatus @default(ACTIVE)
  apolloId      String?        @unique // id de Apollo, para no volver a enriquecer al mismo
  source        String         @default("manual") // "manual" | "apollo"
  // "buyer" = cliente potencial · "reference" = quien publica mucho y a quien
  // comentamos por alcance. El tono del comentario cambia según cuál sea.
  kind          String         @default("buyer")
  // Dos relojes distintos a propósito. `lastEngagedAt` mide trabajo real
  // hecho (comentarios publicados) y es la métrica que interesa mirar.
  // `lastTouchedAt` mueve la cola del briefing: se actualiza también cuando se
  // salta a alguien por no haber publicado nada. Sin esa separación, un
  // prospecto poco activo se queda para siempre como el más antiguo y bloquea
  // uno de los dos huecos diarios indefinidamente.
  lastEngagedAt DateTime? // último comentario registrado
  lastTouchedAt DateTime? // última atención: comentario O salto
  skipCount     Int            @default(0) // saltos consecutivos por falta de actividad
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  engagements ProspectEngagement[]

  @@index([status, kind, lastTouchedAt])
}

model ProspectEngagement {
  id          Int      @id @default(autoincrement())
  prospectId  Int
  postUrl     String? // URL del post del prospecto (si se conoce)
  postExcerpt String?  @db.Text // fragmento del post comentado
  comment     String   @db.Text // comentario publicado
  createdAt   DateTime @default(now())

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId, createdAt])
}

// Rastro de TODA persona que hemos enriquecido en Apollo, se acabe importando
// como prospecto o no. Sin esta tabla, cada ejecución semanal volvería a pagar
// un crédito por los mismos perfiles que ya descartamos. También es el
// contador del presupuesto: filas de los últimos 30 días = créditos gastados.
model ProspectDiscovery {
  id          Int      @id @default(autoincrement())
  apolloId    String   @unique
  name        String?
  title       String?
  company     String?
  linkedinUrl String? // null = enriquecido pero sin perfil utilizable
  imported    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

enum CandidatePosition {
  DEVELOPER
  DESIGNER
  PRODUCT_MANAGER
}

enum CandidateEducation {
  GRADO
  MASTER
  DOCTORADO
  OTHER
}

model Candidate {
  id        Int                @id @default(autoincrement())
  createdAt DateTime           @default(now())
  position  CandidatePosition
  country   String
  education CandidateEducation
  cvBlobUrl String
  aiSummary String?            @db.Text
  emailSent Boolean            @default(false)
  expiresAt DateTime

  @@index([expiresAt])
}
